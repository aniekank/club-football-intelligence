# ─────────────────────────────────────────────────────────────
# Club Football Intelligence — environment configuration
# ─────────────────────────────────────────────────────────────

# Live data source for the active competition:
#   fotmob     → current season, top-5 leagues + UCL/UEL, shot-level xG (no key)
#   statsbomb  → StatsBomb open data, full historical seasons (no key)
#   seed       → deterministic offline generator
DATA_SOURCE=fotmob

# The Odds API — 1X2 / Asian handicap / totals. Free tier is 500 credits a MONTH
# and a call costs one credit per market per region, so the fetcher is budgeted.
ODDS_API_KEY=

# Optional. Present → narratives upgrade from the deterministic engine to Claude.
# The app is fully functional without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Public site URL (absolute OG/social image URLs)
NEXT_PUBLIC_SITE_URL=
